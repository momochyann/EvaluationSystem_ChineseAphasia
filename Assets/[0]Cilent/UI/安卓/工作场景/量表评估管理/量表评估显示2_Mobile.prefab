  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u4E00\u3001\u6D4B\u8BD5\u524D(3 \u70B9\u6838\u5FC3)\r\n\u73AF\u5883\u4E0E\u5DE5\u5177:\u9009\u5B89\u9759\u65E0\u566A\u97F3\u3001\u5149\u7EBF\u67D4\u548C\u7684\u72EC\u7ACB\u7A7A\u95F4\uFF0C\u63A7\u5236\u5728\u573A\u4EBA\u6570(\u4EC5\u6D4B\u8BD5\u8005+\u60A3\u8005\uFF0C\u5FC5\u8981\u65F61\u540D\u6C89\u9ED8\u5BB6\u5C5E\u966A\u540C);\u5907\u9F50\u91CF\u8868\u3001\u56FE\u5361\u3001\u5B9E\u7269\u9053\u5177\u3001\u8BA1\u65F6\u5668\u3001\u5F55\u97F3\u8BBE\u5907\uFF0C\u786E\u8BA4\u91CF\u8868\u4E3A\u6700\u65B0\u7248\u3002\u60A3\u8005\u72B6\u6001:\u786E\u4FDD\u60A3\u8005\u610F\u8BC6\u6E05\u6670\u3001\u6CE8\u610F\u529B\u96C6\u4E2D\uFF0C\u6025\u6027\u671F\u6216\u75B2\u52B3\u65F6\u53EF\u52061-2
    \u6B21\u6D4B(\u6BCF\u6B21\u226440 \u5206\u949F\uFF0C\u95F4\u9694 1-2 \u5C0F\u65F6);\u63D0\u524D\u4E86\u89E3\u5176\u6BCD\u8BED\u3001\u6587\u5316\u7A0B\u5EA6(\u6587\u76F2\u8C03\u6574\u8BFB\u5199\u6D4B\u8BD5\u65B9\u5F0F)\uFF0C\u7528\u6E29\u548C\u8BED\u8A00\u89E3\u91CA\u6D4B\u8BD5\u76EE\u7684\uFF0C\u7F13\u89E3\u7126\u8651\u540E\u518D\u5F00\u59CB\u3002\r\n\u4E8C\u3001\u6D4B\u8BD5\u4E2D(3
    \u70B9\u6838\u5FC3)\u6307\u5BFC\u8BED\u89C4\u8303:\u4E25\u683C\u6309\u91CF\u8868\u6307\u5BFC\u8BED\u63D0\u95EE\uFF0C\u8BED\u8A00\u901A\u4FD7\uFF0C\u4E0D\u989D\u5916\u63D0\u793A;\u60A3\u8005\u672A\u542C\u6E05\u53EF\u91CD\u590D1\u6B21\uFF0C\u4E0D\u6539\u53D8\u63AA\u8F9E\u6216\u589E\u52A0\u89E3\u91CA\u3002\u53CD\u5E94\u5224\u65AD:\u5BA2\u89C2\u533A\u5206\u8BED\u8A00\u969C\u788D\u4E0E\u975E\u8BED\u8A00\u56E0\u7D20(\u5982\u542C\u529B\u969C\u788D\u9700\u5148\u8C03\u6574\u542C\u529B\u3001\u80A2\u4F53\u969C\u788D\u6539\u53E3\u5934\u63CF\u8FF0\uFF0C\u8BA4\u77E5\u969C\u788D\u9700\u6CE8\u660E)\uFF0C\u9010\u5B57\u8BB0\u5F55\u771F\u5B9E\u53CD\u5E94\u3002"
